# ===================================================================
# Configuration Jobby pour Déploiement VPS & Production
# ===================================================================

# Authentification HTTP Basic (fortement recommandé sur VPS public)
# Laissez vide pour un accès libre sans mot de passe
JOBBY_AUTH_USER=admin
JOBBY_AUTH_PASSWORD=change_this_secure_password_123

# Session LinkedIn (cookie li_at pour le scraping authentifié des posts)
LINKEDIN_LI_AT=

# Fournisseurs d'intelligence artificielle (NLP & filtrage automatique)
GEMINI_API_KEY=
OPENAI_API_KEY=
